{
  "$schema": "https://raw.githubusercontent.com/githubnext/gh-cao/main/.github/workflows/shared/cao.schema.json",
  "control-plane": {
    "activity": {
      "repositories": [
        "richard-fowles-epam/cao-lab-control"
      ]
    },
    "campaigns": {
      "repo-assist": {
        "enabled": true,
        "mode": "review",
        "max-repositories": 2,
        "targets": {
          "richard-fowles-epam/cao-lab-target": {
            "mode": "review"
          },
          "richard-fowles-epam/cao-lab-target-2": {
            "mode": "review"
          }
        },
        "workers": {
          "issue-fix": {
            "enabled": true,
            "max-mode": "review",
            "workflow": "repo-assist-issue-fix"
          },
          "issue-triage": {
            "enabled": true,
            "max-mode": "review",
            "workflow": "repo-assist-issue-triage"
          },
          "maintenance": {
            "enabled": true,
            "max-mode": "review",
            "workflow": "repo-assist-maintenance"
          },
          "pr-upkeep": {
            "enabled": true,
            "max-mode": "review",
            "workflow": "repo-assist-pr-upkeep"
          }
        }
      }
    },
    "marketplace": {
      "registries": [
        {
          "auth": {
            "secret": "MARKETPLACE_REGISTRY_TOKEN",
            "type": "pat"
          },
          "id": "official",
          "name": "Official CAO catalog",
          "ref": "main",
          "repository": "githubnext/gh-cao"
        },
        {
          "auth": {
            "secret": "MARKETPLACE_REGISTRY_TOKEN",
            "type": "pat"
          },
          "format": "workflows",
          "id": "agentics",
          "name": "Agentics workflows",
          "path": "workflows",
          "ref": "main",
          "repository": "githubnext/agentics"
        }
      ]
    },
    "scope": {
      "allowed-owners": [
        "richard-fowles-epam"
      ],
      "allowed-repositories": [
        "richard-fowles-epam/cao-lab-control",
        "richard-fowles-epam/cao-lab-target",
        "richard-fowles-epam/cao-lab-target-2"
      ]
    },
    "workflows": {
      "daily-repo-status": {
        "max-mode": "review",
        "max-repositories": 1,
        "mode": "review"
      }
    }
  },
  "gh-aw-version": "v1.2.3",
  "version": 1
}
